# Fly.io Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Fly.io App Configuration
FLYIO_APP_NAME=your-app-name
FLYIO_REGION=nrt
FLYIO_APP_URL=https://your-app-name.fly.dev

# PostgreSQL Database Configuration
FLYIO_DB_NAME=your-app-name-db
POSTGRES_HOST=your-app-name-db.internal
POSTGRES_DB=pokeapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_PORT=5432

# Redis Configuration
FLYIO_REDIS_NAME=your-app-name-redis
REDIS_CONNECTION_STRING=redis://default:your-redis-password@fly-your-app-name-redis.upstash.io:6379

# Django Configuration
DJANGO_SETTINGS_MODULE=config.fly
DEBUG=False
